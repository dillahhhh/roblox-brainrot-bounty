		</Properties>
		<Item class="Script" referent="RBXPlotManager">
			<Properties>
				<string name="Name">PlotManager</string>
				<ProtectedString name="Source"><![CDATA[--[[
    PlotManager.luau
    Lokasi: ServerScriptService > PlotManager
    100% GRATIS: Sistem 8 Base Simetris (Auto Claim saat join, reset saat leave)
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local PlotManager = {}
PlotManager.OccupiedPlots = {} -- [PlotModel] = Player

local plotsFolder = Workspace:FindFirstChild("Plots")
if not plotsFolder then
    plotsFolder = Instance.new("Folder")
    plotsFolder.Name = "Plots"
    plotsFolder.Parent = Workspace
end

function PlotManager.GetPlayerPlot(player)
    for plot, owner in pairs(PlotManager.OccupiedPlots) do
        if owner == player then
            return plot
        end
    end
    return nil
end

local function onPlayerAdded(player)
    local assignedPlot = nil

    -- Loop dari Base1 sampai Base8
    for i = 1, 8 do
        local plot = plotsFolder:FindFirstChild("Base" .. i)
        if plot and not PlotManager.OccupiedPlots[plot] then
            assignedPlot = plot
            PlotManager.OccupiedPlots[plot] = player
            break
        end
    end

    if assignedPlot then
        print(string.format("[Base System] %s mengklaim %s", player.Name, assignedPlot.Name))

        -- Update Sign Papan Nama Base
        local sign = assignedPlot:FindFirstChild("Sign")
        if sign and sign:FindFirstChild("SurfaceGui") then
            local label = sign.SurfaceGui:FindFirstChildOfClass("TextLabel")
            if label then
                label.Text = "Base Milik: " .. player.DisplayName
                label.TextColor3 = Color3.fromRGB(0, 255, 127)
            end
        end

        -- Spawn player di base miliknya
        player.CharacterAdded:Connect(function(character)
            local root = character:WaitForChild("HumanoidRootPart")
            local spawnPart = assignedPlot:FindFirstChild("SpawnPoint")
            if spawnPart then
                task.wait(0.1)
                root.CFrame = spawnPart.CFrame + Vector3.new(0, 3, 0)
            end
        end)
    else
        warn("[Base System] Server penuh, tidak ada base kosong untuk " .. player.Name)
    end
end

local function onPlayerRemoving(player)
    for plot, owner in pairs(PlotManager.OccupiedPlots) do
        if owner == player then
            PlotManager.OccupiedPlots[plot] = nil
            print(string.format("[Base System] %s meninggalkan %s (Kosong)", player.Name, plot.Name))

            -- Reset Sign
            local sign = plot:FindFirstChild("Sign")
            if sign and sign:FindFirstChild("SurfaceGui") then
                local label = sign.SurfaceGui:FindFirstChildOfClass("TextLabel")
                if label then
                    label.Text = plot.Name .. " (Kosong)"
                    label.TextColor3 = Color3.fromRGB(220, 220, 220)
                end
            end
            break
        end
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

return PlotManager
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXEconomyService">
			<Properties>
				<string name="Name">EconomyService</string>
				<ProtectedString name="Source"><![CDATA[--[[
    EconomyService.luau
    Lokasi: ServerScriptService > EconomyService
    100% GRATIS: Sistem Uang (Coins, Gems, Rebirth, Level) + Auto Save DataStore
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EconomyDataStore = nil
pcall(function()
    EconomyDataStore = DataStoreService:GetDataStore("BrainrotEconomy_v1")
end)

local EconomyService = {}

-- Setup RemoteEvents di ReplicatedStorage biar Client bisa minta data
local eventsFolder = ReplicatedStorage:FindFirstChild("Events")
if not eventsFolder then
    eventsFolder = Instance.new("Folder")
    eventsFolder.Name = "Events"
    eventsFolder.Parent = ReplicatedStorage
end

local function setupPlayer(player)
    -- Folder Leaderstats (tampil di kanan atas layar)
    local leaderstats = Instance.new("Folder")
    leaderstats.Name = "leaderstats"
    leaderstats.Parent = player

    local coins = Instance.new("IntValue")
    coins.Name = "Coins 🪙"
    coins.Value = 250 -- Modal awal gratis buat beli telur pertama!
    coins.Parent = leaderstats

    local gems = Instance.new("IntValue")
    gems.Name = "Gems 💎"
    gems.Value = 10
    gems.Parent = leaderstats

    local rebirth = Instance.new("IntValue")
    rebirth.Name = "Rebirth 🔄"
    rebirth.Value = 0
    rebirth.Parent = leaderstats

    local level = Instance.new("IntValue")
    level.Name = "Level ⭐"
    level.Value = 1
    level.Parent = leaderstats

    -- Load Data dari DataStore
    if EconomyDataStore then
        local success, savedData = pcall(function()
            return EconomyDataStore:GetAsync(tostring(player.UserId))
        end)

        if success and savedData then
            coins.Value = savedData.Coins or coins.Value
            gems.Value = savedData.Gems or gems.Value
            rebirth.Value = savedData.Rebirth or rebirth.Value
            level.Value = savedData.Level or level.Value
            print("Data loaded buat " .. player.Name)
        end
    end
end

local function savePlayer(player)
    if not EconomyDataStore then return end
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return end

    local dataToSave = {
        Coins = leaderstats:FindFirstChild("Coins 🪙") and leaderstats["Coins 🪙"].Value or 0,
        Gems = leaderstats:FindFirstChild("Gems 💎") and leaderstats["Gems 💎"].Value or 0,
        Rebirth = leaderstats:FindFirstChild("Rebirth 🔄") and leaderstats["Rebirth 🔄"].Value or 0,
        Level = leaderstats:FindFirstChild("Level ⭐") and leaderstats["Level ⭐"].Value or 1,
    }

    local success, err = pcall(function()
        EconomyDataStore:SetAsync(tostring(player.UserId), dataToSave)
    end)

    if success then
        print("Data sukses tersimpan buat " .. player.Name)
    else
        warn("Gagal save data " .. player.Name .. ": " .. tostring(err))
    end
end

-- Rebirth System
function EconomyService.DoRebirth(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return false end

    local coins = leaderstats:FindFirstChild("Coins 🪙")
    local rebirth = leaderstats:FindFirstChild("Rebirth 🔄")

    local cost = (rebirth.Value + 1) * 50000

    if coins.Value >= cost then
        coins.Value = 0 -- Reset koin
        rebirth.Value += 1
        print(player.Name .. " Berhasil Rebirth ke-" .. rebirth.Value)
        return true
    else
        return false, "Koin kurang! Butuh " .. cost .. " Koin."
    end
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(savePlayer)

-- Auto save saat server shutdown
game:BindToClose(function()
    for _, player in ipairs(Players:GetPlayers()) do
        savePlayer(player)
    end
end)

return EconomyService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXEggService">
			<Properties>
				<string name="Name">EggService</string>
				<ProtectedString name="Source"><![CDATA[--[[
    EggService.luau
    Lokasi: ServerScriptService > EggService
    100% GRATIS: Logika Gacha Telur Brainrot, Roll RNG, Simpan ke Inventory Player
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local EggConfig = require(ReplicatedStorage:WaitForChild("EggConfig"))

local EggService = {}
local PlayerInventories = {} -- [Player] = { "Noob", "SkibidiBasic", ... }

-- Siapkan RemoteFunction buat Client minta Beli Telur
local eventsFolder = ReplicatedStorage:WaitForChild("Events")
local buyEggFunc = eventsFolder:FindFirstChild("BuyEgg")
if not buyEggFunc then
    buyEggFunc = Instance.new("RemoteFunction")
    buyEggFunc.Name = "BuyEgg"
    buyEggFunc.Parent = eventsFolder
end

-- Algoritma Roll Telur (Weighted Random)
local function rollEgg(eggName, rebirthLevel)
    local eggData = EggConfig.Eggs[eggName]
    if not eggData then return nil end

    -- Hitung total chance
    local totalWeight = 0
    for _, drop in ipairs(eggData.Drops) do
        totalWeight += drop.Chance
    end

    local randomNum = math.random() * totalWeight
    local currentWeight = 0

    for _, drop in ipairs(eggData.Drops) do
        currentWeight += drop.Chance
        if randomNum <= currentWeight then
            return drop.Pet
        end
    end

    return eggData.Drops[1].Pet
end

function EggService.HatchEgg(player, eggName)
    local eggData = EggConfig.Eggs[eggName]
    if not eggData then
        return false, "Telur tidak ditemukan!"
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        return false, "Data player belum siap!"
    end

    local coins = leaderstats:FindFirstChild("Coins 🪙")
    local rebirth = leaderstats:FindFirstChild("Rebirth 🔄")
    local rebirthVal = rebirth and rebirth.Value or 0

    -- Cek uang cukup atau tidak
    if coins.Value < eggData.Cost then
        return false, "Koin tidak cukup! Butuh " .. eggData.Cost .. " Koin."
    end

    -- Potong uang
    coins.Value -= eggData.Cost

    -- Roll Pet
    local hatchedPetId = rollEgg(eggName, rebirthVal)
    local petInfo = EggConfig.Pets[hatchedPetId]

    -- Masukkan ke Inventory
    if not PlayerInventories[player] then
        PlayerInventories[player] = {}
    end
    table.insert(PlayerInventories[player], hatchedPetId)

    print(string.format("[Gacha Telur] %s berhasil menetaskan %s (%s)!", player.Name, petInfo.DisplayName, petInfo.Rarity))

    return true, {
        PetId = hatchedPetId,
        Name = petInfo.DisplayName,
        Rarity = petInfo.Rarity,
        Multiplier = petInfo.Multiplier
    }
end

-- Handle panggilan dari Client GUI
buyEggFunc.OnServerInvoke = function(player, eggName)
    return EggService.HatchEgg(player, eggName)
end

Players.PlayerRemoving:Connect(function(player)
    PlayerInventories[player] = nil
end)

return EggService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXPedestalService">
			<Properties>
				<string name="Name">PedestalService</string>
				<ProtectedString name="Source"><![CDATA[--[[
    PedestalService.luau
    Lokasi: ServerScriptService > PedestalService
    100% GRATIS: Sistem Pajang Brainrot di Base & Generate Passive Income Koin/Detik
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local EggConfig = require(ReplicatedStorage:WaitForChild("EggConfig"))
local PlotManager = require(script.Parent:WaitForChild("PlotManager"))

local PedestalService = {}

-- Loop Passive Income tiap 1 detik
task.spawn(function()
    while true do
        task.wait(1)
        for _, player in ipairs(Players:GetPlayers()) do
            local plot = PlotManager.GetPlayerPlot(player)
            if plot then
                local pedestalsFolder = plot:FindFirstChild("Pedestals")
                if pedestalsFolder then
                    local totalMultiplier = 0

                    for _, stand in ipairs(pedestalsFolder:GetChildren()) do
                        local petValue = stand:FindFirstChild("EquippedPet")
                        if petValue and petValue.Value ~= "" then
                            local petData = EggConfig.Pets[petValue.Value]
                            if petData then
                                totalMultiplier += petData.Multiplier
                            end
                        end
                    end

                    if totalMultiplier > 0 then
                        local leaderstats = player:FindFirstChild("leaderstats")
                        if leaderstats and leaderstats:FindFirstChild("Coins 🪙") then
                            leaderstats["Coins 🪙"].Value += totalMultiplier
                        end
                    end
                end
            end
        end
    end
end)

-- Fungsi pasang pet ke pedestal base
function PedestalService.EquipPetToPedestal(player, pedestalNumber, petId)
    local plot = PlotManager.GetPlayerPlot(player)
    if not plot then return false, "Kamu belum punya base!" end

    local pedestals = plot:FindFirstChild("Pedestals")
    if not pedestals then return false, "Folder Pedestals tidak ditemukan di base!" end

    local targetStand = pedestals:FindFirstChild("Stand" .. pedestalNumber)
    if not targetStand then return false, "Pedestal tidak valid!" end

    local petValue = targetStand:FindFirstChild("EquippedPet")
    if not petValue then
        petValue = Instance.new("StringValue")
        petValue.Name = "EquippedPet"
        petValue.Parent = targetStand
    end

    petValue.Value = petId
    local petData = EggConfig.Pets[petId]

    -- Update Label Teks di Atas Stand
    local sign = targetStand:FindFirstChild("Sign")
    if sign and sign:FindFirstChild("SurfaceGui") then
        local label = sign.SurfaceGui:FindFirstChildOfClass("TextLabel")
        if label and petData then
            label.Text = petData.DisplayName .. "\n(+" .. petData.Multiplier .. " Koin/dtk)"
            label.TextColor3 = Color3.fromRGB(255, 215, 0)
        end
    end

    print(string.format("[Pedestal] %s memajang %s di Stand %d!", player.Name, petData.DisplayName, pedestalNumber))
    return true
end

return PedestalService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXMarketChest">
			<Properties>
				<string name="Name">MarketChest</string>
				<ProtectedString name="Source"><![CDATA[--[[
    MarketChest.luau
    Lokasi: ServerScriptService > MarketChest
    100% GRATIS: Peti Harta Karun Pasar Tengah (Tempat farming Koin gratis untuk beli Telur)
]]

local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local MarketChest = {}

local CHEST_RESPAWN_TIME = 45 -- Respawn tiap 45 detik
local CHEST_HEALTH = 15       -- Butuh 15x sentuhan / pukulan buat hancur

local function createChest(position)
    local chest = Instance.new("Part")
    chest.Name = "MarketChest"
    chest.Size = Vector3.new(4, 4, 4)
    chest.Position = position
    chest.Anchored = true
    chest.Material = Enum.Material.Neon
    chest.Color = Color3.fromRGB(255, 170, 0) -- Warna Emas
    chest.Parent = Workspace

    -- BillboardGui buat nampilin Darah Peti
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = chest

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.FredokaOne
    label.Text = "📦 PETI PASAR\nHP: " .. CHEST_HEALTH
    label.Parent = billboard

    local currentHP = CHEST_HEALTH
    local isDestroyed = false

    chest.Touched:Connect(function(hit)
        if isDestroyed then return end
        local character = hit.Parent
        local player = game.Players:GetPlayerFromCharacter(character)

        if player then
            currentHP -= 1
            label.Text = "📦 PETI PASAR\nHP: " .. math.max(0, currentHP)

            -- Efek visual kena pukul
            chest.Color = Color3.fromRGB(255, 255, 255)
            task.delay(0.1, function()
                if not isDestroyed then
                    chest.Color = Color3.fromRGB(255, 170, 0)
                end
            end)

            -- Kalau HP habis, beri hadiah Koin & Gems ke player yang menghancurkan
            if currentHP <= 0 then
                isDestroyed = true
                label.Text = "💥 TERBUKA!"

                local leaderstats = player:FindFirstChild("leaderstats")
                if leaderstats then
                    local coinsReward = math.random(300, 800)
                    local gemsReward = math.random(5, 15)

                    leaderstats["Coins 🪙"].Value += coinsReward
                    leaderstats["Gems 💎"].Value += gemsReward

                    print(string.format("[Peti Pasar] %s menghancurkan peti! Dapet +%d Koin & +%d Gems!", player.Name, coinsReward, gemsReward))
                end

                chest.Transparency = 1
                chest.CanCollide = false
                task.wait(1)
                chest:Destroy()

                -- Tunggu waktu respawn, lalu spawn peti baru lagi
                task.wait(CHEST_RESPAWN_TIME)
                createChest(position)
            end
        end
    end)
end

-- Posisi peti tepat di tengah Plaza Pasar Nusantara
local centerPosition = Vector3.new(0, 5, 0)
task.spawn(function()
    createChest(centerPosition)
end)

return MarketChest
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="Lighting" referent="RBXLighting">
		<Properties>
			<string name="Name">Lighting</string>
			<Color3 name="Ambient"><R>0.5</R><G>0.5</G><B>0.5</B></Color3>
			<float name="Brightness">2</float>
		</Properties>
