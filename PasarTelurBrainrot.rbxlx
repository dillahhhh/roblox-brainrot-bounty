	<Item class="ServerScriptService" referent="RBXServerScriptService">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBXPlotManager">
			<Properties>
				<string name="Name">PlotManager</string>
				<ProtectedString name="Source"><![CDATA[--[[
    PlotManager.luau
    Lokasi: ServerScriptService > PlotManager
    100% GRATIS: Sistem 8 Base Simetris (Auto Claim saat join, reset saat leave)
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local PlotManager = {}
PlotManager.OccupiedPlots = {} -- [PlotModel] = Player

local plotsFolder = Workspace:FindFirstChild("Plots")
if not plotsFolder then
    plotsFolder = Instance.new("Folder")
    plotsFolder.Name = "Plots"
    plotsFolder.Parent = Workspace
end

function PlotManager.GetPlayerPlot(player)
    for plot, owner in pairs(PlotManager.OccupiedPlots) do
        if owner == player then
            return plot
        end
    end
    return nil
end

local function onPlayerAdded(player)
    local assignedPlot = nil

    -- Loop dari Base1 sampai Base8
    for i = 1, 8 do
        local plot = plotsFolder:FindFirstChild("Base" .. i)
        if plot and not PlotManager.OccupiedPlots[plot] then
            assignedPlot = plot
            PlotManager.OccupiedPlots[plot] = player
            break
        end
    end

    if assignedPlot then
        print(string.format("[Base System] %s mengklaim %s", player.Name, assignedPlot.Name))

        -- Update Sign Papan Nama Base
        local sign = assignedPlot:FindFirstChild("Sign")
        if sign and sign:FindFirstChild("SurfaceGui") then
            local label = sign.SurfaceGui:FindFirstChildOfClass("TextLabel")
            if label then
                label.Text = "Base Milik: " .. player.DisplayName
                label.TextColor3 = Color3.fromRGB(0, 255, 127)
            end
        end

        -- Spawn player di base miliknya
        player.CharacterAdded:Connect(function(character)
            local root = character:WaitForChild("HumanoidRootPart")
            local spawnPart = assignedPlot:FindFirstChild("SpawnPoint")
            if spawnPart then
                task.wait(0.1)
                root.CFrame = spawnPart.CFrame + Vector3.new(0, 3, 0)
            end
        end)
    else
        warn("[Base System] Server penuh, tidak ada base kosong untuk " .. player.Name)
    end
end

local function onPlayerRemoving(player)
    for plot, owner in pairs(PlotManager.OccupiedPlots) do
        if owner == player then
            PlotManager.OccupiedPlots[plot] = nil
            print(string.format("[Base System] %s meninggalkan %s (Kosong)", player.Name, plot.Name))

            -- Reset Sign
            local sign = plot:FindFirstChild("Sign")
            if sign and sign:FindFirstChild("SurfaceGui") then
                local label = sign.SurfaceGui:FindFirstChildOfClass("TextLabel")
                if label then
                    label.Text = plot.Name .. " (Kosong)"
                    label.TextColor3 = Color3.fromRGB(220, 220, 220)
                end
            end
            break
        end
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

return PlotManager
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXEconomyService">
			<Properties>
				<string name="Name">EconomyService</string>
				<ProtectedString name="Source"><![CDATA[--[[
    EconomyService.luau
    Lokasi: ServerScriptService > EconomyService
    100% GRATIS: Sistem Uang (Coins, Gems, Rebirth, Level) + Auto Save DataStore
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EconomyDataStore = nil
pcall(function()
    EconomyDataStore = DataStoreService:GetDataStore("BrainrotEconomy_v1")
end)

local EconomyService = {}

-- Setup RemoteEvents di ReplicatedStorage biar Client bisa minta data
local eventsFolder = ReplicatedStorage:FindFirstChild("Events")
if not eventsFolder then
    eventsFolder = Instance.new("Folder")
    eventsFolder.Name = "Events"
    eventsFolder.Parent = ReplicatedStorage
end

local function setupPlayer(player)
    -- Folder Leaderstats (tampil di kanan atas layar)
    local leaderstats = Instance.new("Folder")
    leaderstats.Name = "leaderstats"
    leaderstats.Parent = player

    local coins = Instance.new("IntValue")
    coins.Name = "Coins 🪙"
    coins.Value = 250 -- Modal awal gratis buat beli telur pertama!
    coins.Parent = leaderstats

    local gems = Instance.new("IntValue")
    gems.Name = "Gems 💎"
    gems.Value = 10
    gems.Parent = leaderstats

    local rebirth = Instance.new("IntValue")
    rebirth.Name = "Rebirth 🔄"
    rebirth.Value = 0
    rebirth.Parent = leaderstats

    local level = Instance.new("IntValue")
    level.Name = "Level ⭐"
    level.Value = 1
    level.Parent = leaderstats

    -- Load Data dari DataStore
    if EconomyDataStore then
        local success, savedData = pcall(function()
            return EconomyDataStore:GetAsync(tostring(player.UserId))
        end)

        if success and savedData then
            coins.Value = savedData.Coins or coins.Value
            gems.Value = savedData.Gems or gems.Value
            rebirth.Value = savedData.Rebirth or rebirth.Value
            level.Value = savedData.Level or level.Value
            print("Data loaded buat " .. player.Name)
        end
    end
end

local function savePlayer(player)
    if not EconomyDataStore then return end
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return end

    local dataToSave = {
        Coins = leaderstats:FindFirstChild("Coins 🪙") and leaderstats["Coins 🪙"].Value or 0,
        Gems = leaderstats:FindFirstChild("Gems 💎") and leaderstats["Gems 💎"].Value or 0,
        Rebirth = leaderstats:FindFirstChild("Rebirth 🔄") and leaderstats["Rebirth 🔄"].Value or 0,
        Level = leaderstats:FindFirstChild("Level ⭐") and leaderstats["Level ⭐"].Value or 1,
    }

    local success, err = pcall(function()
        EconomyDataStore:SetAsync(tostring(player.UserId), dataToSave)
    end)

    if success then
        print("Data sukses tersimpan buat " .. player.Name)
    else
        warn("Gagal save data " .. player.Name .. ": " .. tostring(err))
    end
end

-- Rebirth System
function EconomyService.DoRebirth(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then return false end

    local coins = leaderstats:FindFirstChild("Coins 🪙")
    local rebirth = leaderstats:FindFirstChild("Rebirth 🔄")

    local cost = (rebirth.Value + 1) * 50000

    if coins.Value >= cost then
        coins.Value = 0 -- Reset koin
        rebirth.Value += 1
        print(player.Name .. " Berhasil Rebirth ke-" .. rebirth.Value)
        return true
    else
        return false, "Koin kurang! Butuh " .. cost .. " Koin."
    end
end

Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(savePlayer)

-- Auto save saat server shutdown
game:BindToClose(function()
    for _, player in ipairs(Players:GetPlayers()) do
        savePlayer(player)
    end
end)

return EconomyService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXEggService">
			<Properties>
				<string name="Name">EggService</string>
				<ProtectedString name="Source"><![CDATA[--[[
    EggService.luau
    Lokasi: ServerScriptService > EggService
    100% GRATIS: Logika Gacha Telur Brainrot, Roll RNG, Simpan ke Inventory Player
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local EggConfig = require(ReplicatedStorage:WaitForChild("EggConfig"))

local EggService = {}
local PlayerInventories = {} -- [Player] = { "Noob", "SkibidiBasic", ... }

-- Siapkan RemoteFunction buat Client minta Beli Telur
local eventsFolder = ReplicatedStorage:WaitForChild("Events")
local buyEggFunc = eventsFolder:FindFirstChild("BuyEgg")
if not buyEggFunc then
    buyEggFunc = Instance.new("RemoteFunction")
    buyEggFunc.Name = "BuyEgg"
    buyEggFunc.Parent = eventsFolder
end

-- Algoritma Roll Telur (Weighted Random)
local function rollEgg(eggName, rebirthLevel)
    local eggData = EggConfig.Eggs[eggName]
    if not eggData then return nil end

    -- Hitung total chance
    local totalWeight = 0
    for _, drop in ipairs(eggData.Drops) do
        totalWeight += drop.Chance
    end

    local randomNum = math.random() * totalWeight
    local currentWeight = 0

    for _, drop in ipairs(eggData.Drops) do
        currentWeight += drop.Chance
        if randomNum <= currentWeight then
            return drop.Pet
        end
    end

    return eggData.Drops[1].Pet
end

function EggService.HatchEgg(player, eggName)
    local eggData = EggConfig.Eggs[eggName]
    if not eggData then
        return false, "Telur tidak ditemukan!"
    end

    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        return false, "Data player belum siap!"
    end

    local coins = leaderstats:FindFirstChild("Coins 🪙")
    local rebirth = leaderstats:FindFirstChild("Rebirth 🔄")
    local rebirthVal = rebirth and rebirth.Value or 0

    -- Cek uang cukup atau tidak
    if coins.Value < eggData.Cost then
        return false, "Koin tidak cukup! Butuh " .. eggData.Cost .. " Koin."
    end

    -- Potong uang
    coins.Value -= eggData.Cost

    -- Roll Pet
    local hatchedPetId = rollEgg(eggName, rebirthVal)
    local petInfo = EggConfig.Pets[hatchedPetId]

    -- Masukkan ke Inventory
    if not PlayerInventories[player] then
        PlayerInventories[player] = {}
    end
    table.insert(PlayerInventories[player], hatchedPetId)

    print(string.format("[Gacha Telur] %s berhasil menetaskan %s (%s)!", player.Name, petInfo.DisplayName, petInfo.Rarity))

    return true, {
        PetId = hatchedPetId,
        Name = petInfo.DisplayName,
        Rarity = petInfo.Rarity,
        Multiplier = petInfo.Multiplier
    }
end

-- Handle panggilan dari Client GUI
buyEggFunc.OnServerInvoke = function(player, eggName)
    return EggService.HatchEgg(player, eggName)
end

Players.PlayerRemoving:Connect(function(player)
    PlayerInventories[player] = nil
end)

return EggService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXPedestalService">
			<Properties>
				<string name="Name">PedestalService</string>
				<ProtectedString name="Source"><![CDATA[--[[
    PedestalService.luau
    Lokasi: ServerScriptService > PedestalService
    100% GRATIS: Sistem Pajang Brainrot di Base & Generate Passive Income Koin/Detik
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local EggConfig = require(ReplicatedStorage:WaitForChild("EggConfig"))
local PlotManager = require(script.Parent:WaitForChild("PlotManager"))

local PedestalService = {}

-- Loop Passive Income tiap 1 detik
task.spawn(function()
    while true do
        task.wait(1)
        for _, player in ipairs(Players:GetPlayers()) do
            local plot = PlotManager.GetPlayerPlot(player)
            if plot then
                local pedestalsFolder = plot:FindFirstChild("Pedestals")
                if pedestalsFolder then
                    local totalMultiplier = 0

                    for _, stand in ipairs(pedestalsFolder:GetChildren()) do
                        local petValue = stand:FindFirstChild("EquippedPet")
                        if petValue and petValue.Value ~= "" then
                            local petData = EggConfig.Pets[petValue.Value]
                            if petData then
                                totalMultiplier += petData.Multiplier
                            end
                        end
                    end

                    if totalMultiplier > 0 then
                        local leaderstats = player:FindFirstChild("leaderstats")
                        if leaderstats and leaderstats:FindFirstChild("Coins 🪙") then
                            leaderstats["Coins 🪙"].Value += totalMultiplier
                        end
                    end
                end
            end
        end
    end
end)

-- Fungsi pasang pet ke pedestal base
function PedestalService.EquipPetToPedestal(player, pedestalNumber, petId)
    local plot = PlotManager.GetPlayerPlot(player)
    if not plot then return false, "Kamu belum punya base!" end

    local pedestals = plot:FindFirstChild("Pedestals")
    if not pedestals then return false, "Folder Pedestals tidak ditemukan di base!" end

    local targetStand = pedestals:FindFirstChild("Stand" .. pedestalNumber)
    if not targetStand then return false, "Pedestal tidak valid!" end

    local petValue = targetStand:FindFirstChild("EquippedPet")
    if not petValue then
        petValue = Instance.new("StringValue")
        petValue.Name = "EquippedPet"
        petValue.Parent = targetStand
    end

    petValue.Value = petId
    local petData = EggConfig.Pets[petId]

    -- Update Label Teks di Atas Stand
    local sign = targetStand:FindFirstChild("Sign")
    if sign and sign:FindFirstChild("SurfaceGui") then
        local label = sign.SurfaceGui:FindFirstChildOfClass("TextLabel")
        if label and petData then
            label.Text = petData.DisplayName .. "\n(+" .. petData.Multiplier .. " Koin/dtk)"
            label.TextColor3 = Color3.fromRGB(255, 215, 0)
        end
    end

    print(string.format("[Pedestal] %s memajang %s di Stand %d!", player.Name, petData.DisplayName, pedestalNumber))
    return true
end

return PedestalService
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBXMarketChest">
			<Properties>
				<string name="Name">MarketChest</string>
				<ProtectedString name="Source"><![CDATA[--[[
    MarketChest.luau
    Lokasi: ServerScriptService > MarketChest
    100% GRATIS: Peti Harta Karun Pasar Tengah (Tempat farming Koin gratis untuk beli Telur)
]]

local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local MarketChest = {}

local CHEST_RESPAWN_TIME = 45 -- Respawn tiap 45 detik
local CHEST_HEALTH = 15       -- Butuh 15x sentuhan / pukulan buat hancur

local function createChest(position)
    local chest = Instance.new("Part")
    chest.Name = "MarketChest"
    chest.Size = Vector3.new(4, 4, 4)
    chest.Position = position
    chest.Anchored = true
    chest.Material = Enum.Material.Neon
    chest.Color = Color3.fromRGB(255, 170, 0) -- Warna Emas
    chest.Parent = Workspace

    -- BillboardGui buat nampilin Darah Peti
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = chest

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextScaled = true
    label.Font = Enum.Font.FredokaOne
    label.Text = "📦 PETI PASAR\nHP: " .. CHEST_HEALTH
    label.Parent = billboard

    local currentHP = CHEST_HEALTH
    local isDestroyed = false

    chest.Touched:Connect(function(hit)
        if isDestroyed then return end
        local character = hit.Parent
        local player = game.Players:GetPlayerFromCharacter(character)

        if player then
            currentHP -= 1
            label.Text = "📦 PETI PASAR\nHP: " .. math.max(0, currentHP)

            -- Efek visual kena pukul
            chest.Color = Color3.fromRGB(255, 255, 255)
            task.delay(0.1, function()
                if not isDestroyed then
                    chest.Color = Color3.fromRGB(255, 170, 0)
                end
            end)

            -- Kalau HP habis, beri hadiah Koin & Gems ke player yang menghancurkan
            if currentHP <= 0 then
                isDestroyed = true
                label.Text = "💥 TERBUKA!"

                local leaderstats = player:FindFirstChild("leaderstats")
                if leaderstats then
                    local coinsReward = math.random(300, 800)
                    local gemsReward = math.random(5, 15)

                    leaderstats["Coins 🪙"].Value += coinsReward
                    leaderstats["Gems 💎"].Value += gemsReward

                    print(string.format("[Peti Pasar] %s menghancurkan peti! Dapet +%d Koin & +%d Gems!", player.Name, coinsReward, gemsReward))
                end

                chest.Transparency = 1
                chest.CanCollide = false
                task.wait(1)
                chest:Destroy()

                -- Tunggu waktu respawn, lalu spawn peti baru lagi
                task.wait(CHEST_RESPAWN_TIME)
                createChest(position)
            end
        end
    end)
end

-- Posisi peti tepat di tengah Plaza Pasar Nusantara
local centerPosition = Vector3.new(0, 5, 0)
task.spawn(function()
    createChest(centerPosition)
end)

return MarketChest
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBXStarterPlayer">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBXStarterPlayerScripts">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBXHUDController">
				<Properties>
					<string name="Name">HUDController</string>
					<ProtectedString name="Source"><![CDATA[--[[
    HUDController.luau
    Lokasi: StarterPlayer > StarterPlayerScripts > HUDController (atau StarterGui)
    Nampilin Koin, Gems, Level, Rebirth di layar secara real-time & animasi notifikasi gacha
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Bikin ScreenGui HUD
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BrainrotHUD"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Frame Stats di Kiri Atas
local statsFrame = Instance.new("Frame")
statsFrame.Name = "StatsFrame"
statsFrame.Size = UDim2.new(0, 220, 0, 140)
statsFrame.Position = UDim2.new(0, 20, 0, 20)
statsFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
statsFrame.BorderSizePixel = 0
statsFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 12)
uiCorner.Parent = statsFrame

local uiStroke = Instance.new("UIStroke")
uiStroke.Color = Color3.fromRGB(80, 80, 120)
uiStroke.Thickness = 2
uiStroke.Parent = statsFrame

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
listLayout.Parent = statsFrame

local function createStatLabel(name, text, color)
    local label = Instance.new("TextLabel")
    label.Name = name
    label.Size = UDim2.new(0.9, 0, 0, 26)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.FredokaOne
    label.TextSize = 18
    label.TextColor3 = color
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = text
    label.Parent = statsFrame
    return label
end

local coinsLabel = createStatLabel("CoinsLabel", "🪙 Koin: 0", Color3.fromRGB(255, 215, 0))
local gemsLabel = createStatLabel("GemsLabel", "💎 Gems: 0", Color3.fromRGB(0, 220, 255))
local levelLabel = createStatLabel("LevelLabel", "⭐ Level: 1", Color3.fromRGB(255, 170, 0))
local rebirthLabel = createStatLabel("RebirthLabel", "🔄 Rebirth: 0", Color3.fromRGB(200, 100, 255))

-- Update otomatis pas stats berubah
local function bindStats()
    local leaderstats = player:WaitForChild("leaderstats", 10)
    if not leaderstats then return end

    local coins = leaderstats:WaitForChild("Coins 🪙", 5)
    local gems = leaderstats:WaitForChild("Gems 💎", 5)
    local level = leaderstats:WaitForChild("Level ⭐", 5)
    local rebirth = leaderstats:WaitForChild("Rebirth 🔄", 5)

    if coins then
        coinsLabel.Text = "🪙 Koin: " .. coins.Value
        coins.Changed:Connect(function(val)
            coinsLabel.Text = "🪙 Koin: " .. val
        end)
    end

    if gems then
        gemsLabel.Text = "💎 Gems: " .. gems.Value
        gems.Changed:Connect(function(val)
            gemsLabel.Text = "💎 Gems: " .. val
        end)
    end

    if level then
        levelLabel.Text = "⭐ Level: " .. level.Value
        level.Changed:Connect(function(val)
            levelLabel.Text = "⭐ Level: " .. val
        end)
    end

    if rebirth then
        rebirthLabel.Text = "🔄 Rebirth: " .. rebirth.Value
        rebirth.Changed:Connect(function(val)
            rebirthLabel.Text = "🔄 Rebirth: " .. val
        end)
    end
end

task.spawn(bindStats)

-- Banner Notifikasi Hasil Gacha (Popup Tengah Layar)
local notifBanner = Instance.new("Frame")
notifBanner.Name = "NotifBanner"
notifBanner.Size = UDim2.new(0, 400, 0, 100)
notifBanner.Position = UDim2.new(0.5, -200, 0.2, 0)
notifBanner.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
notifBanner.BorderSizePixel = 0
notifBanner.Visible = false
notifBanner.Parent = screenGui

local bannerCorner = Instance.new("UICorner")
bannerCorner.CornerRadius = UDim.new(0, 16)
bannerCorner.Parent = notifBanner

local bannerStroke = Instance.new("UIStroke")
bannerStroke.Color = Color3.fromRGB(255, 215, 0)
bannerStroke.Thickness = 3
bannerStroke.Parent = notifBanner

local bannerTitle = Instance.new("TextLabel")
bannerTitle.Size = UDim2.new(1, 0, 0.4, 0)
bannerTitle.BackgroundTransparency = 1
bannerTitle.Font = Enum.Font.FredokaOne
bannerTitle.TextSize = 20
bannerTitle.TextColor3 = Color3.fromRGB(255, 215, 0)
bannerTitle.Text = "🎉 TELUR MENETAS!"
bannerTitle.Parent = notifBanner

local bannerDesc = Instance.new("TextLabel")
bannerDesc.Position = UDim2.new(0, 0, 0.4, 0)
bannerDesc.Size = UDim2.new(1, 0, 0.5, 0)
bannerDesc.BackgroundTransparency = 1
bannerDesc.Font = Enum.Font.FredokaOne
bannerDesc.TextSize = 24
bannerDesc.TextColor3 = Color3.fromRGB(255, 255, 255)
bannerDesc.Text = "Mendapatkan: Pet"
bannerDesc.Parent = notifBanner

-- Global function buat nampilin popup
_G.ShowHatchNotification = function(petName, rarity, multiplier)
    bannerDesc.Text = petName .. " (" .. rarity .. ")\n+" .. multiplier .. " Koin/dtk!"
    notifBanner.Visible = true
    notifBanner.Position = UDim2.new(0.5, -200, 0.15, 0)
    TweenService:Create(notifBanner, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Position = UDim2.new(0.5, -200, 0.2, 0)
    }):Play()

    task.delay(3, function()
        notifBanner.Visible = false
    end)
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBXEggShopClient">
				<Properties>
					<string name="Name">EggShopClient</string>
					<ProtectedString name="Source"><![CDATA[--[[
    EggShopClient.luau
    Lokasi: StarterPlayer > StarterPlayerScripts > EggShopClient (atau StarterGui)
    UI Belanja & Gacha Telur Brainrot di Pasar Tengah
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local EggConfig = require(ReplicatedStorage:WaitForChild("EggConfig"))
local eventsFolder = ReplicatedStorage:WaitForChild("Events")
local buyEggFunc = eventsFolder:WaitForChild("BuyEgg")

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "EggShopGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- Tombol Buka Toko di Kiri Layar (Ikon Toko ala Pasar Nusantara)
local openButton = Instance.new("TextButton")
openButton.Name = "OpenShopButton"
openButton.Size = UDim2.new(0, 70, 0, 70)
openButton.Position = UDim2.new(0, 20, 0.4, 0)
openButton.BackgroundColor3 = Color3.fromRGB(240, 140, 30)
openButton.Text = "🛒\nTOKO"
openButton.Font = Enum.Font.FredokaOne
openButton.TextSize = 18
openButton.TextColor3 = Color3.fromRGB(255, 255, 255)
openButton.Parent = screenGui

local openCorner = Instance.new("UICorner")
openCorner.CornerRadius = UDim.new(0, 16)
openCorner.Parent = openButton

local openStroke = Instance.new("UIStroke")
openStroke.Color = Color3.fromRGB(255, 215, 0)
openStroke.Thickness = 3
openStroke.Parent = openButton

-- Frame Modal Toko (Pop-up di Tengah)
local shopFrame = Instance.new("Frame")
shopFrame.Name = "ShopModal"
shopFrame.Size = UDim2.new(0, 650, 0, 380)
shopFrame.Position = UDim2.new(0.5, -325, 0.5, -190)
shopFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
shopFrame.Visible = false
shopFrame.BorderSizePixel = 0
shopFrame.Parent = screenGui

local modalCorner = Instance.new("UICorner")
modalCorner.CornerRadius = UDim.new(0, 20)
modalCorner.Parent = shopFrame

local modalStroke = Instance.new("UIStroke")
modalStroke.Color = Color3.fromRGB(255, 170, 0)
modalStroke.Thickness = 3
modalStroke.Parent = shopFrame

-- Header Toko
local header = Instance.new("TextLabel")
header.Size = UDim2.new(1, 0, 0, 50)
header.BackgroundTransparency = 1
header.Text = "🥚 LAPAK TELUR BRAINROT NUSANTARA 🥚"
header.Font = Enum.Font.FredokaOne
header.TextSize = 22
header.TextColor3 = Color3.fromRGB(255, 215, 0)
header.Parent = shopFrame

-- Tombol Close
local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 40, 0, 40)
closeButton.Position = UDim2.new(1, -50, 0, 10)
closeButton.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
closeButton.Text = "X"
closeButton.Font = Enum.Font.FredokaOne
closeButton.TextSize = 20
closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
closeButton.Parent = shopFrame

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 10)
closeCorner.Parent = closeButton

-- Grid Kartu Telur
local eggGrid = Instance.new("ScrollingFrame")
eggGrid.Size = UDim2.new(0.95, 0, 0, 300)
eggGrid.Position = UDim2.new(0.025, 0, 0, 60)
eggGrid.BackgroundTransparency = 1
eggGrid.ScrollBarThickness = 6
eggGrid.CanvasSize = UDim2.new(0, 600, 0, 0)
eggGrid.Parent = shopFrame

local gridLayout = Instance.new("UIGridLayout")
gridLayout.CellSize = UDim2.new(0, 140, 0, 260)
gridLayout.CellPadding = UDim2.new(0, 10, 0, 10)
gridLayout.Parent = eggGrid

-- Buat Kartu Telur untuk tiap jenis telur di EggConfig
local eggOrder = { "TelurOhio", "TelurRizz", "TelurSkibidi", "TelurSigma" }

for _, eggKey in ipairs(eggOrder) do
    local eggData = EggConfig.Eggs[eggKey]
    if eggData then
        local card = Instance.new("Frame")
        card.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
        card.Parent = eggGrid

        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 12)
        cardCorner.Parent = card

        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, 0, 0, 40)
        title.BackgroundTransparency = 1
        title.Text = eggData.DisplayName
        title.Font = Enum.Font.FredokaOne
        title.TextSize = 14
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextWrapped = true
        title.Parent = card

        local eggIcon = Instance.new("TextLabel")
        eggIcon.Size = UDim2.new(1, 0, 0, 70)
        eggIcon.Position = UDim2.new(0, 0, 0, 40)
        eggIcon.BackgroundTransparency = 1
        eggIcon.Text = "🥚"
        eggIcon.TextSize = 48
        eggIcon.Parent = card

        local priceLabel = Instance.new("TextLabel")
        priceLabel.Size = UDim2.new(1, 0, 0, 30)
        priceLabel.Position = UDim2.new(0, 0, 0, 120)
        priceLabel.BackgroundTransparency = 1
        priceLabel.Text = "🪙 " .. eggData.Cost
        priceLabel.Font = Enum.Font.FredokaOne
        priceLabel.TextSize = 16
        priceLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        priceLabel.Parent = card

        local hatchBtn = Instance.new("TextButton")
        hatchBtn.Size = UDim2.new(0.85, 0, 0, 40)
        hatchBtn.Position = UDim2.new(0.075, 0, 0, 160)
        hatchBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        hatchBtn.Text = "TETASKAN!"
        hatchBtn.Font = Enum.Font.FredokaOne
        hatchBtn.TextSize = 14
        hatchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        hatchBtn.Parent = card

        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 8)
        btnCorner.Parent = hatchBtn

        hatchBtn.MouseButton1Click:Connect(function()
            hatchBtn.Text = "MEMBUKA..."
            local success, result = buyEggFunc:InvokeServer(eggKey)
            if success and result then
                hatchBtn.Text = "BERHASIL!"
                if _G.ShowHatchNotification then
                    _G.ShowHatchNotification(result.Name, result.Rarity, result.Multiplier)
                end
            else
                hatchBtn.Text = "GAGAL!"
                warn(tostring(result))
            end
            task.delay(1, function()
                hatchBtn.Text = "TETASKAN!"
            end)
        end)
    end
end

-- Toggle Toko
openButton.MouseButton1Click:Connect(function()
    shopFrame.Visible = not shopFrame.Visible
end)

closeButton.MouseButton1Click:Connect(function()
    shopFrame.Visible = false
end)
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="Lighting" referent="RBXLighting">
		<Properties>
			<string name="Name">Lighting</string>
			<Color3 name="Ambient"><R>0.5</R><G>0.5</G><B>0.5</B></Color3>
			<float name="Brightness">2</float>
		</Properties>
	</Item>
